---
// مِعْمَارُ الوَحْيِ - قراءة البيانات الديناميكية آلياً
import fs from 'fs';
import path from 'path';
import yaml from 'js-yaml';

// قراءة ملف البيانات الذكي للمحور الأول بالحرف والتشكيل المعتمد
const filePath = path.resolve('src/pages/01-al-urwa-al-wuthqa/01-rawasikh-al-iman/data-content.yaml');
const fileContent = fs.readFileSync(filePath, 'utf8');
const data = yaml.load(fileContent);

const portalTitle = data.portal;
const axisTitle = data.axis;
const descLine1 = data.axis_description.line_1;
const descLine2 = data.axis_description.line_2;
const items = data.items;
---

<!DOCTYPE html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>مِعْمَارُ الوَحْيِ | MIMAR AL-WAHY</title>
    <link rel="preconnect" href="https://googleapis.com">
    <link rel="preconnect" href="https://gstatic.com" crossorigin>
    <link href="https://googleapis.com/css2?family=Cairo:wght@300;400;600;700;900&display=swap" rel="stylesheet">
    
    <style>
      :root {
        --bg-glass-sky: rgba(15, 23, 42, 0.95);
        --strong-gold: #D4AF37;
        --bold-white: #FFFFFF;
        --text-muted: #E2E8F0;
        --accent-blue: #87CEEB;
      }

      * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Cairo', sans-serif; }
      body { background: radial-gradient(circle at center, #1e293b 0%, #0f172a 100%); color: var(--bold-white); min-height: 100vh; padding: 2rem 1rem; }
      .container { max-width: 1200px; margin: 0 auto; }
      
      header { text-align: center; margin-bottom: 3rem; padding: 2rem; background: rgba(255, 255, 255, 0.03); border-radius: 16px; backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.05); }
      h1 { color: var(--strong-gold); font-size: 3rem; font-weight: 900; margin-bottom: 0.5rem; }
      .subtitle { color: var(--accent-blue); font-size: 1.2rem; font-weight: 600; margin-bottom: 1.5rem; }
      
      .tagline-box { display: flex; flex-direction: column; gap: 0.5rem; max-width: 700px; margin: 0 auto; font-size: 0.95rem; color: var(--text-muted); text-align: right; background: rgba(212, 175, 55, 0.05); padding: 1rem; border-right: 4px solid var(--strong-gold); border-radius: 4px; }
      
      .axis-header { border-bottom: 1px solid rgba(212, 175, 55, 0.2); padding-bottom: 1rem; margin-bottom: 2rem; }
      .portal-badge { color: var(--accent-blue); font-weight: 700; font-size: 1.1rem; margin-bottom: 0.5rem; text-align: center; }
      .axis-title { color: var(--strong-gold); font-size: 1.8rem; font-weight: 900; margin-bottom: 0.5rem; text-align: center; }
      
      .search-section { max-width: 700px; margin: 0 auto 2.5rem auto; }
      .search-box { width: 100%; padding: 1.2rem; font-size: 1.1rem; background: rgba(255, 255, 255, 0.05); border: 2px solid rgba(135, 212, 235, 0.2); border-radius: 50px; color: var(--bold-white); text-align: center; backdrop-filter: blur(8px); }
      
      .tabs-container { display: flex; justify-content: center; gap: 1rem; margin-bottom: 3rem; flex-wrap: wrap; }
      .tab-btn { padding: 0.8rem 2rem; font-size: 1rem; font-weight: 700; background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; color: var(--bold-white); cursor: pointer; }
      .tab-btn.active { background: var(--strong-gold); color: #0f172a; border-color: var(--strong-gold); }
      
      .grid-layout { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 2rem; }
      .card { background: var(--bg-glass-sky); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 16px; padding: 1.5rem; display: flex; flex-direction: column; justify-content: space-between; position: relative; overflow: hidden; backdrop-filter: blur(16px); }
      .card::before { content: ''; position: absolute; top: 0; left: 0; width: 100%; height: 4px; background: var(--accent-blue); }
      .card.book::before { background: var(--strong-gold); }
      .card.video::before { background: #ef4444; }
      
      .card-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; }
      .badge { padding: 0.3rem 0.8rem; font-size: 0.75rem; font-weight: 700; border-radius: 50px; }
      .badge.article { color: var(--accent-blue); background: rgba(135, 212, 235, 0.1); }
      .badge.book { color: var(--strong-gold); background: rgba(212, 175, 55, 0.1); }
      .badge.video { color: #f87171; background: rgba(239, 68, 68, 0.1); }
      
      .card-title { font-size: 1.25rem; font-weight: 700; margin-bottom: 0.5rem; line-height: 1.4; color: var(--bold-white); text-align: right; }
      .card-author { color: var(--strong-gold); font-size: 0.9rem; margin-bottom: 1rem; text-align: right; }
      .card-summary { color: var(--text-muted); font-size: 0.9rem; line-height: 1.6; margin-bottom: 1.5rem; text-align: right; }
      
      .card-actions { display: flex; gap: 0.8rem; }
      .btn { flex: 1; padding: 0.6rem; font-size: 0.9rem; font-weight: 700; text-align: center; border-radius: 8px; cursor: pointer; border: none; text-decoration: none; }
      .btn-details { background: rgba(255, 255, 255, 0.08); color: var(--bold-white); }
      .btn-source { background: var(--accent-blue); color: #0f172a; }
    </style>
  </head>
  
  <body>
    <div class="container">
      <header>
        <h1>مِعْمَارُ الوَحْيِ</h1>
        <div class="subtitle">MIMAR AL-WAHY</div>
        <div class="tagline-box">
          <div class="portal-badge">{portalTitle}</div>
          <div class="axis-title">{axisTitle}</div>
          <div>{descLine1}</div>
          <div>{descLine2}</div>
        </div>
      </header>

      <div class="search-section">
        <input type="text" class="search-box" placeholder="معارج البحث الرقمي — ابحث في المحاور والمواد..." />
      </div>

      <div class="tabs-container">
        <button class="tab-btn active">الكل</button>
        <button class="tab-btn">مقالات وأبحاث</button>
        <button class="tab-btn">كتب ورسائل جامعية</button>
        <button class="tab-btn">مرئيات</button>
      </div>

      <div class="grid-layout">
        {items.map((item) => (
          <div class={`card ${item.type}`}>
            <div>
              <div class="card-header">
                <span class={`badge ${item.type}`}>
                  {item.type === 'article' && '📄 مقال فكري'}
                  {item.type === 'book' && '📚 كتاب / رسالة'}
                  {item.type === 'video' && '🎥 مرئيات'}
                </span>
                <span style="font-size: 0.8rem; color: #94a3b8;">المواد</span>
              </div>
              <div class="card-title">{item.title}</div>
              <div class="card-author">{item.author}</div>
              <div class="card-summary">{item.summary}</div>
            </div>
            <div class="card-actions">
              <button class="btn btn-details">التفاصيل</button>
              <a href={item.source_url} target="_blank" class="btn btn-source">
                {item.type === 'book' ? 'اقرأ الكتاب' : item.type === 'video' ? 'شاهد الآن' : 'المصدر'}
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </body>
</html>